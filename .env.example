# Mira — environment configuration.
# Copy to .env for local dev. In prod these are passed to the container
# (see deploy/compose.prod.yaml).

# Postgres connection string used by the app when it runs outside Compose (npm run dev,
# scripts/smoke.sh). The Compose files build their own from the POSTGRES_* values below.
DATABASE_URL=postgres://mira:mira@localhost:5432/mira

# Credentials for the bundled Postgres service in the compose files.
POSTGRES_USER=mira
# For production set a unique strong value. Dev compose supplies a local-only
# fallback when this is empty; production compose refuses an empty value.
POSTGRES_PASSWORD=
POSTGRES_DB=mira

# Local Node execution only. Production Compose uses a named volume at /data
# with MEDIA_DIR=/data/media; this value does not change the Compose mount.
MEDIA_DIR=./data/media

# ORIGIN is the exact address people type (scheme and port included): form posts
# from any other host name or port are rejected.
# PUBLIC_ORIGIN is used to build share links and QR codes; the production Compose
# file uses ORIGIN when it is not set.
ORIGIN=http://localhost:5180
PUBLIC_ORIGIN=http://localhost:5180

# adapter-node request body limit. Raise in prod or large videos are rejected
# before reaching the app. Units allowed, e.g. 3G. (vite dev ignores it.)
BODY_SIZE_LIMIT=64M

# adapter-node client IP handling behind exactly one trusted reverse proxy.
# Change the header/depth to match your proxy chain; never expose the container
# port publicly when trusting a forwarded address header.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Seconds adapter-node lets in-flight requests finish after SIGTERM.
SHUTDOWN_TIMEOUT=30

# --- Production Compose only (deploy/compose.prod.yaml) -----------------------
# Image to run. Leave unset for the published release named in the Compose file, or pin
# another version (there is no "latest" tag). To run an image built from this
# repository (docker build -t mira:local .), set it here and skip "compose pull".
# MIRA_IMAGE=mira:local
# Port on 127.0.0.1 that the app is published on. Your reverse proxy forwards to it.
# MIRA_PORT=5180

# --- Who runs this copy (shown to guests) -------------------------------------
# Shown on the sign-in page, the join page and /privacy, so someone opening an
# invitation knows whose server their photos are going to. All optional: without
# them the pages say "a private copy of Mira, run by whoever sent you the link".
# MIRA_OPERATOR_NAME=Ana Etxeberria
# An email address or an https:// page where people can reach you.
# MIRA_OPERATOR_CONTACT=ana@example.org
# One sentence on how long photos are kept.
# MIRA_RETENTION_NOTE=Albums are deleted one year after the event.

# --- Accounts (album owners) -------------------------------------------------
# Owners sign in via OAuth to create/manage albums; guests joining a shared link
# never need an account. Auth is handled by @auth/sveltekit.

# Secret used to sign session JWTs. Required by the production-image preview and
# production deployment; generate with: openssl rand -base64 33
AUTH_SECRET=

# The simplest way in: a password for the sign-in page, at least 12 characters.
# Whoever knows it is the administrator (one account, "password:admin"). No
# application has to be registered with Google or GitHub. After ten wrong tries the
# password sign-in pauses for five minutes; changing it signs that account out.
# MIRA_ADMIN_PASSWORD=
# The name that account is shown under (default: Administrator).
# MIRA_ADMIN_NAME=

# Or: comma-separated, exact provider account identities that receive administrator
# access. Find the provider account id from the OAuth provider. There is no
# "first user becomes admin" fallback.
# MIRA_ADMIN_IDENTITIES=google:1234567890,github:123456

# Sign-in services for other people who should own albums (optional when
# MIRA_ADMIN_PASSWORD is set). Each activates only when BOTH id and secret are set. Add any of
# Google / Facebook / GitHub (more is just another pair of vars + a provider in
# src/auth.ts). Callback URL is https://<your-domain>/auth/callback/<provider>.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# DEV ONLY: enable the password-less "Dev login" provider so the full owner/admin
# flow can be exercised without an HTTPS OAuth callback. NEVER set in production.
# MIRA_DEV_AUTH=1
