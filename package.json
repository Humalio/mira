{
	"name": "mira",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Mira — shared photo & video albums for trips and meetups.",
	"license": "MIT",
	"author": "Bruno Simões",
	"homepage": "https://github.com/Humalio/mira#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Humalio/mira.git"
	},
	"bugs": {
		"url": "https://github.com/Humalio/mira/issues"
	},
	"keywords": [
		"sveltekit",
		"postgres",
		"drizzle",
		"photos",
		"pwa",
		"sharp"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prestart": "node scripts/init-db.mjs",
		"start": "node scripts/start.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:database": "node --test scripts/init-db.test.mjs",
		"test:smoke": "sh scripts/smoke.sh",
		"test:watch": "vitest",
		"db:init": "node --env-file-if-exists=.env scripts/init-db.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/archiver": "^8.0.0",
		"@types/qrcode": "^1.5.6",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@auth/sveltekit": "^1.11.3",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"@lucide/svelte": "^1.59.0",
		"archiver": "^8.0.0",
		"drizzle-orm": "^0.45.4",
		"exifr": "^7.1.3",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.5"
	},
	"overrides": {
		"@auth/sveltekit": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
